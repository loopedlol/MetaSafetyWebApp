# Development example only. Production values must be supplied by the host.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=false
# Temporary physical-glasses development testing only; leave disabled normally.
DEV_TUNNEL_MODE=false
DEV_TUNNEL_ORIGIN=
REGISTRATION_KEY=change-me-local-dev-key
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_MS=43200000
GLASSES_PAIRING_TTL_MS=300000
GLASSES_SESSION_TTL_MS=3600000
GLASSES_PAIRING_MAX_ATTEMPTS=5
AI_MODE=mock
AI_API_KEY=
DATABASE_PATH=./data/safety-lens.sqlite
UPLOADS_DIR=./uploads
ABANDONED_UPLOAD_TTL_HOURS=24
RETENTION_CLEANUP_INTERVAL_MINUTES=60
SHUTDOWN_TIMEOUT_MS=10000
